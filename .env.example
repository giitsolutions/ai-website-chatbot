DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/chatbot

# Admin key for /api/register and /api/website (header: x-admin-api-key).
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=CHANGE_ME

# Optional settings (defaults shown)
# PORT=3000
# MAX_QUESTION_LENGTH=500
# MAX_WAITING_GENERATIONS=2
# CRAWL_MAX_PAGES=8
# TRUST_PROXY=1
# Answer models. Defaults: qwen3:4b with thinking for every question (slow, ~60 s).
# Recommended (measured 2-15 s for most questions; see docs/TEST_REPORT.md):
#   ollama pull qwen3:4b-instruct-2507-q4_K_M
# LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# LLM_THINK=false
# Questions about the visitor's own situation ("45 days ago - can I still...?") use:
# LLM_REASONING_MODEL=qwen3:4b
# LLM_REASONING_THINK=true
# OLLAMA_KEEP_ALIVE=5m
# Several admin keys for rotation (each at least 32 characters):
# ADMIN_API_KEYS=alice:CHANGE_ME,ci:CHANGE_ME
# Uploaded documents: max size per file in MB (1-50) and per chatbot (1-500).
# DOCUMENT_MAX_MB=10
# DOCUMENTS_PER_CHATBOT=50
# Signs visitor links to documents the owner opened to visitors (at least 32 characters).
# Without it a random secret is made at each start (links then stop working after a restart).
# DOCUMENT_LINK_SECRET=CHANGE_ME
# "Email your question" for unanswered questions (needs a support email per chatbot in the dashboard).
# Without SMTP_HOST and SMTP_FROM the option is not offered. Port 587 = STARTTLS; 465 with SMTP_SECURE=true.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=CHANGE_ME
# SMTP_PASS=CHANGE_ME
# SMTP_FROM=chatbot@example.com
# Automated tests only: EMAIL_TRANSPORT=test keeps messages in memory and never sends them.
# Isolated tests only (set by tests/run-isolated.js; leave unset for the real server):
# QDRANT_COLLECTION=website_content_test   other Qdrant collection (default website_content)
# UPLOAD_DIR=C:\temp\chatbot-test-uploads   other folder for stored documents (default data/uploads)
